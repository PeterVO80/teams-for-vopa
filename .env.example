# On the internet (portainer-stack.yml): the domain name. Caddy then gets an
# HTTPS certificate and the app runs in HTTPS mode; APP_URL becomes
# https://<DOMAIN>. Leave empty on a test server (plain http on WEB_PORT).
# DOMAIN=teams.vopa.be
# BACKUP_KEEP_DAYS=14

# Copy this file to `.env` and adjust the values before starting the stack.

# Secret used to sign session cookies and CSRF tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# PostgreSQL credentials (used by both the `db` and the `web` container).
POSTGRES_USER=vopa
POSTGRES_PASSWORD=vopa
POSTGRES_DB=vopa

# First administrator account, created automatically on first start-up
# when no users exist yet. Change the password after logging in!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# Prefix of the automatically generated project codes: PRJ/2026/0001, ...
PROJECT_CODE_PREFIX=PRJ

# Maximum upload size in MB (supplier price lists can be large).
MAX_UPLOAD_MB=300

# Port on which the web application is published on the host.
WEB_PORT=8000

# Outlook / Microsoft 365 calendar link (optional, see README "Outlook").
# Leave empty to disable.
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TIMEZONE=Romance Standard Time
# Colour of the "VOPA Teams" category in Outlook: rood, oranje, bruin, geel,
# groen, blauwgroen, olijf, blauw, paars, cranberry, grijs, ... (empty = leave alone)
# Needs the extra permission MailboxSettings.ReadWrite (see README).
MS365_CATEGORY_COLOR=oranje
# Log in with the Microsoft 365 account: off, on (button + passwords) or
# required (only Microsoft; administrators keep their password as fallback).
MICROSOFT_LOGIN=off
# Address of the app, used as a link in the Outlook appointments.
APP_URL=

# Optional: distances to customers via Google Maps (Distance Matrix API) instead of OpenStreetMap
GOOGLE_MAPS_API_KEY=
