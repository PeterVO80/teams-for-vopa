# Caddy configuration of the stack (portainer-stack.yml).
#
# SITE_ADDRESS is the stack's DOMAIN (e.g. teams.vopa.be): Caddy then
# requests and renews a Let's Encrypt certificate itself and redirects
# http:// to https://. Without a DOMAIN it is ":80": plain http, for a test
# server on the local network.

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Supplier price lists (DBF) can be large.
	request_body {
		max_size 300MB
	}

	header {
		-Server
	}

	reverse_proxy web:8000

	log {
		output stdout
		format console
	}
}
